<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.woorifisan.platform.domain.bank.mapper.BankMapper">

    <select id="findById" resultType="com.woorifisan.platform.domain.bank.model.Bank">
        SELECT * FROM bank WHERE id = #{id}
    </select>

    <select id="findByBankCode" resultType="com.woorifisan.platform.domain.bank.model.Bank">
        SELECT * FROM bank WHERE bank_code = #{bankCode}
    </select>

    <select id="findAll" resultType="com.woorifisan.platform.domain.bank.model.Bank">
        SELECT id,
               bank_code   AS bankCode,
               bank_name   AS bankName,
               base_url    AS baseUrl,
               is_active   AS isActive,
               created_at  AS createdAt,
               updated_at  AS updatedAt
        FROM bank
    </select>

</mapper>
