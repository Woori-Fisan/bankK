<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ── 프로퍼티 ──────────────────────────────────── -->
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="./logs"/>
    <property name="LOG_FILE" value="${LOG_PATH}/application.log"/>

    <!-- ── 콘솔 (개발용) ─────────────────────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [traceId=%X{traceId}, staffId=%X{staffId}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ── JSON 파일 (Fluent Bit 파싱 대상) ──────────── -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 날짜별 롤링, 30일 보관 -->
            <fileNamePattern>${LOG_PATH}/application.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <!-- Fluent Bit이 파싱할 수 있도록 JSON 형식으로 출력 -->
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeContext>false</includeContext>
            <fieldNames>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <!-- 서비스 식별용 필드 -->
            <customFields>{"service":"agency-platform"}</customFields>
            
            <!-- MDC 설정을 통해 구조화된 데이터 지원 -->
            <includeMdc>true</includeMdc>
            <excludeMdcKeyName>password</excludeMdcKeyName>
            <excludeMdcKeyName>token</excludeMdcKeyName>
        </encoder>
    </appender>

    <!-- ── 비동기 래퍼 (메인 스레드 블로킹 방지) ─────── -->
    <!-- DOMAIN_MONITOR.md: 모든 로깅은 완전 비동기로 처리 -->
    <appender name="ASYNC_JSON_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="JSON_FILE"/>
        <!-- 큐가 80% 차면 TRACE/DEBUG/INFO 드롭, ERROR는 유지 -->
        <discardingThreshold>20</discardingThreshold>
        <queueSize>512</queueSize>
        <!-- 종료 시 큐 비울 때까지 최대 대기 시간 -->
        <maxFlushTime>1000</maxFlushTime>
    </appender>

    <!-- ── 프로파일별 설정 ────────────────────────────── -->
    <!-- 로컬 개발: 콘솔 + JSON 파일(임시 테스트) -->
    <springProfile name="local">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_JSON_FILE"/>
        </root>
        <logger name="com.woorifisan.platform" level="DEBUG"/>
    </springProfile>

    <!-- 개발 서버: 콘솔 + JSON 파일 -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_JSON_FILE"/>
        </root>
        <logger name="com.woorifisan.platform" level="DEBUG"/>
    </springProfile>

    <!-- 운영: JSON 파일만 (Fluent Bit 수집 대상) -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="ASYNC_JSON_FILE"/>
        </root>
    </springProfile>

</configuration>