# [Global] Monorepo .gitignore

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Java / Gradle ---
.gradle/
build/
bin/
out/
!gradle/wrapper/gradle-wrapper.jar
gradle-app.setting
.project
.classpath
.settings/
.nb-gradle/

# --- Node.js / Frontend ---
node_modules/
dist/
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Environment & Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.jks

# --- Monitoring / Infrastructure ---
# Prometheus/Grafana data if mapped locally
data/
logs/
*.log

# --- Project Specific ---
temp/
tmp/
history/
platform/backend/uploads/

coverage/
