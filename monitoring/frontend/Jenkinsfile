pipeline {
    agent any

    tools {
        // 'Node 18' 부분은 Jenkins [Global Tool Configuration]에 등록한 NodeJS 이름과 정확히 일치해야 합니다.
        nodejs 'NodeJS 24.12.0' 
    }

    stages {
        stage('Hello') {
            steps {
                echo 'Platform frontend'
                echo "변경된 파일 목록: ${changed_files}"
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                // package.json을 기반으로 의존성 패키지를 설치합니다.
                dir('monitoring/frontend') {
                    echo 'Installing frontend dependencies...'
                    sh 'npm install'
                }
            }
        }

        stage('Build React App') {
            steps {
                // 리액트 프로젝트를 빌드합니다. (build 또는 dist 폴더 생성)
                dir('monitoring/frontend') {
                    echo 'Building the frontend project...'
                    sh 'npm run build'
                }
            }
        }

        stage('Compress Build Output') {
            steps {
                dir('monitoring/frontend') {
                    echo 'Compressing build output...'
                    // Create React App은 'build', Vite는 'dist' 폴더를 생성합니다. (환경에 맞게 수정)
                    sh 'tar -czvf frontend-build.tar.gz dist/' 
                }
            }
        }

        stage('Deploy to Server') {
            steps {
                // 프론트엔드 서버 접속용 SSH 인증서 ID
                sshagent(['Monitoring_Frontend_SSH']) {
                    dir('monitoring/frontend') {
                        // 1. 압축 파일을 서버의 임시 폴더(/tmp)로 전송
                        echo 'Transferring file to server...'
                        sh "scp -o StrictHostKeyChecking=no frontend-build.tar.gz ubuntu@10.10.5.141:/tmp/"

                        // 2. 서버에 SSH로 접속하여 기존 파일 삭제, 압축 해제 및 Nginx 재시작
                        echo 'Extracting files and applying to Nginx...'
                        sh """
                            ssh -o StrictHostKeyChecking=no ubuntu@10.10.5.141 << EOF
                                echo "--- 1. 기존 Nginx 웹 루트 파일 비우기 ---"
                                # sudo 권한이 필요할 수 있습니다.
                                sudo rm -rf /var/www/html/*
                                
                                echo "--- 2. 임시 폴더에서 압축 해제 ---"
                                tar -xzvf /tmp/frontend-build.tar.gz -C /tmp/
                                
                                echo "--- 3. 새 빌드 파일을 Nginx 경로로 이동 ---"
                                # 압축 푼 'dist' 폴더 안의 내용물만 이동
                                sudo cp -r /tmp/dist/* /var/www/html/
                                
                                echo "--- 4. 임시 파일 찌꺼기 삭제 ---"
                                rm -rf /tmp/dist
                                rm /tmp/frontend-build.tar.gz
                                
                                echo "--- 5. Nginx 설정 리로드 ---"
                                sudo systemctl reload nginx
                                
                                echo "--- 프론트엔드 배포 성공! ---"
EOF
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo '🎉 빌드가 성공적으로 완료되었습니다!'
        }
        failure {
            echo '🚨 빌드에 실패했습니다. 로그를 확인해주세요.'
        }
    }
}