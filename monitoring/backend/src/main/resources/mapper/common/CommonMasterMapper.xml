<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.woorifisan.monitoring.domain.common.mapper.CommonMasterMapper">

    <select id="findAllActiveBanks" resultType="com.woorifisan.monitoring.domain.common.dto.response.BankResponseDTO">
        SELECT
            bank_code as bankCode,
            bank_name as bankName
        FROM bank
        WHERE is_active = 1
        ORDER BY bank_name ASC
    </select>

    <select id="findAllActiveAgencies" resultType="com.woorifisan.monitoring.domain.common.dto.response.AgencyResponseDTO">
        SELECT
            agency_code as agencyCode,
            agency_name as agencyName
        FROM agency
        WHERE is_active = 1
        ORDER BY agency_name ASC
    </select>

</mapper>
