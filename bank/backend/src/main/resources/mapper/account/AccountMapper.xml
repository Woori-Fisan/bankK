<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.woorifisan.bank.domain.account.mapper.AccountMapper">
    <select id="findById" resultType="Account">
        SELECT * FROM account WHERE id = #{id}
    </select>

    <select id="findByAccountNoHashAndRrnPrefix" resultType="Account">
        SELECT
            a.*
        FROM account a
        INNER JOIN customer c ON a.customer_id = c.id
        WHERE a.account_no_hash = #{accountNoHash}
          AND c.rrn_prefix_enc = #{rrnPrefixEnc}
    </select>
</mapper>
